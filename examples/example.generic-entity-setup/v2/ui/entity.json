{
  "contractVersion": 1,
  "contributionId": "example.generic-entity-setup.entity-panel",
  "contributionVersion": "1.0.0",
  "kind": "panel",
  "entityTypeId": "example.generic-entity-setup.entity",
  "entitySchemaVersion": 1,
  "capability": { "id": "example.generic-entity-setup", "apiVersion": "1.0.0", "implementationVersion": "1.0.0", "digest": "sha256:f8e987b3dd4c191aca10709165eea94afef87263ff1df040bbbd635efcf46d4e" },
  "entityCapability": { "id": "example.generic-entity-setup.entity", "apiVersion": "1.0.0", "implementationVersion": "1.0.0", "digest": "sha256:f8e987b3dd4c191aca10709165eea94afef87263ff1df040bbbd635efcf46d4e" },
  "entitySchema": { "type": "object", "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "role": { "type": "string", "enum": ["navigator", "keeper"] },
    "resources": { "type": "object", "properties": {
      "calm": { "type": "integer", "minimum": 0, "maximum": 3 },
      "omen": { "type": "integer", "minimum": 0, "maximum": 2 }

{
  "contractVersion": 1,
  "contributionId": "example.dicepool.scene-ui",
  "contributionVersion": "1.1.0",
  "kind": "panel",
  "capability": {
    "id": "example.dicepool.ui",
    "apiVersion": "1.0.0",
    "implementationVersion": "1.0.0",
    "digest": "sha256:2a8826195a503dce6c585df4f988fbe4715d443ebc31eab8ef80290fb3366595"
  },
  "entityTypeId": "example.dicepool.scene",
  "entityCapability": {
    "id": "example.dicepool.scene",
    "apiVersion": "1.0.0",
    "implementationVersion": "1.0.0",
    "digest": "sha256:ea27fa5a54e92dfb0e90aa6f9c5d773054e19316231e8907f76168e58d445caa"
  },
  "entitySchemaVersion": 1,
  "entitySchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "status": {
        "type": "string",
        "enum": [
          "ready",
          "active",
          "resolved"
        ]
      },
      "obstacle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "characters": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "ownerPrincipalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "pool": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "stress": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "push": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "id",
            "name",
            "ownerPrincipalId",
            "pool",
            "stress",
            "push",
            "role"
          ],
          "additionalProperties": false
        }
      },
      "log": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "gmNote": {
        "type": "string",
        "maxLength": 160
      }
    },
    "required": [
      "title",
      "status",
      "obstacle",
      "characters",
      "log",
      "gmNote"
    ],
    "additionalProperties": false
  },
  "commands": [
    {
      "commandId": "example.dicepool.skill-challenge",
      "capability": {
        "id": "example.dicepool.commands",
        "apiVersion": "1.0.0",
        "implementationVersion": "1.0.0",
        "digest": "sha256:e8747dd8b444de68fdc3b8a4b5c365b03177be59455d8bdfccca6de24a19cf24"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "push": {
            "type": "boolean"
          }
        },
        "required": [
          "actorId",
          "difficulty",
          "push"
        ],
        "additionalProperties": false
      }
    },
    {
      "commandId": "example.dicepool.contested-action",
      "capability": {
        "id": "example.dicepool.commands",
        "apiVersion": "1.0.0",
        "implementationVersion": "1.0.0",
        "digest": "sha256:e8747dd8b444de68fdc3b8a4b5c365b03177be59455d8bdfccca6de24a19cf24"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "defenderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "push": {
            "type": "boolean"
          }
        },
        "required": [
          "actorId",
          "defenderId",
          "push"
        ],
        "additionalProperties": false
      }
    }
  ],
  "workflows": [],
  "slots": [],
  "nodes": [
    {
      "kind": "section",
      "id": "example.dicepool.rules.scene",
      "label": "Scene and resources",
      "children": [
        {
          "kind": "display",
          "id": "example.dicepool.rules.title",
          "path": "title",
          "label": "Scene"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.status",
          "path": "status",
          "label": "Status"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.obstacle",
          "path": "obstacle",
          "label": "Obstacle"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.character-names",
          "path": "characters.*.name",
          "label": "Characters"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.pools",
          "path": "characters.*.pool",
          "label": "Dice pools"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.stress",
          "path": "characters.*.stress",
          "label": "Stress"
        },
        {
          "kind": "display",
          "id": "example.dicepool.rules.log",
          "path": "log",
          "label": "Outcomes"
        }
      ]
    },
    {
      "kind": "section",
      "id": "example.dicepool.rules.actions",
      "label": "Declared actions",
      "children": [
        {
          "kind": "form",
          "id": "example.dicepool.rules.skill-challenge",
          "commandId": "example.dicepool.skill-challenge",
          "label": "Resolve skill challenge"
        },
        {
          "kind": "form",
          "id": "example.dicepool.rules.contested-action",
          "commandId": "example.dicepool.contested-action",
          "label": "Start contested action"
        }
      ]
    }
  ]
}

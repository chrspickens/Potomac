            "classLevel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "secondWindMaximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "secondWindUses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "ownerPrincipalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128

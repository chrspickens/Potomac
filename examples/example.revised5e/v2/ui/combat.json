  "entitySchemaVersion": 2,
  "entitySchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "enum": [
          "setup",
          "active",
          "complete"
        ]
      },
      "actors": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "type": "string",
              "enum": [
                "player",
                "enemy"
              ]
            },
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "speed": {
              "type": "integer",
              "enum": [
                25,
                30,
                35,
                40
